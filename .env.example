PORT=4000
HOST=0.0.0.0
# Your Mac's LAN IP — used in startup logs; update if your IP changes
LAN_HOST=192.168.100.156
NODE_ENV=development

# JWT secret — required in production (Vercel / Netlify env vars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins (Expo web + local + hosted frontend)
# Production — paste into Vercel backend env var CORS_ORIGINS (optional extras).
# Automatically allowed: *.vercel.app and *.qrshopmyanmar.com
# CORS_ORIGINS=http://localhost:8081,https://another-custom-domain.com
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://192.168.100.156:8081

# Odoo
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=

# Optional: extra res.partner (contact) fields to fetch, comma-separated
# technical names. Example: x_studio_loyalty_id,x_studio_region
ODOO_CONTACT_EXTRA_FIELDS=

# Custom Township model technical name (Studio). Used to resolve city/state/zip/country.
ODOO_TOWNSHIP_MODEL=x_townships

# Product membership pricelist names (matched with ilike against product.pricelist.name)
# ODOO_PRICELIST_PREMIUM_NAME=Premium Membership
# ODOO_PRICELIST_PRO_NAME=Pro Membership

# Optional Overview AI suggestions (Gemini preferred)
# Set AI_INSIGHTS_ENABLED=true and GEMINI_API_KEY to turn on.
# AI_INSIGHTS_ENABLED=true
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# AI_INSIGHTS_DATA_DIR=
# Overview FAB chat uses Odoo AI (Odoo 19.2 Online: HTTP /ai routes, not private RPC).
# Analyze six month stays on Gemini.
# OVERVIEW_CHAT_PROVIDER=odoo
# ODOO_AI_AGENT_NAME=
# ODOO_AI_AGENT_ID=
# OVERVIEW_CHAT_FALLBACK_GEMINI=true


# App Order read/unread (REQUIRED on Vercel — shared across all users/devices)
# Redis Cloud (Vercel Marketplace) — preferred if you just created it:
# REDIS_URL=rediss://...
# — or Upstash / KV REST —
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Local/dev: if unset, falls back to data/app-order-read/read.json
# APP_ORDER_READ_DATA_DIR=

# TEMPORARY — Call list / App installation (MongoDB Atlas)
# Kill switch: ENABLE_APP_INSTALL_CALL_LIST=false (routes unmounted)
# MONGODB_URI=mongodb+srv://...
# ENABLE_APP_INSTALL_CALL_LIST=true
